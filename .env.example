# DiscMon environment template. Copy to .env and set real secrets locally.
# Never commit .env.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
TZ=UTC
DATABASE_URL=postgresql+psycopg://discmon:discmon@127.0.0.1:55432/discmon

# Owner access. "disabled" is only accepted for local development.
OWNER_AUTH_MODE=disabled
OWNER_API_TOKEN=change-me-owner-token
SESSION_SECRET=change-me-session-secret
ALLOWED_ORIGINS=http://localhost:3000

# Ingestion
COLLECTOR_GLOBAL_CONCURRENCY=4
DEFAULT_SOURCE_INTERVAL_HOURS=24
FETCH_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=20000000
RAW_RETENTION_DAYS=30
LOG_LEVEL=INFO
ALLOW_PRIVATE_FETCH_HOSTS=false

# Optional integrations (disabled by default)
GITHUB_TOKEN=
CHANGEDETECTION_BASE_URL=
CHANGEDETECTION_API_KEY=
CHANGEDETECTION_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
SHEETS_SYNC_ENABLED=false

# Optional AI (off by default; no paid credential required for MVP)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
AI_ENABLED=false
AI_DAILY_CALL_BUDGET=0
AI_MONTHLY_SPEND_BUDGET_USD=0

# Web server-side proxy only (not exposed to browser)
INTERNAL_API_URL=http://localhost:8000
INTERNAL_API_TOKEN=change-me-owner-token
